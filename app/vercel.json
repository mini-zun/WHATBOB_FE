{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://whatbob.kro.kr/static/:path*"
    },
    {
      "source": "/room/:roomId",
      "destination": "/room/[roomId]"
    }
  ]
}
